generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  ADMIN
  USER
  CUSTOMER
}

enum CampaignStatus {
  ACTIVE
  READY_TO_DRAW
  FINISHED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  type      UserType

  // Indicação (para afiliados)
  referredById Int?
  referredBy   User?  @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[] @relation("UserReferrals")

  links     ReferralLink[]
  tickets   Ticket[]
  campaigns Campaign[]     @relation("CampaignCreatedBy")

  profile   Profile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReferralLink {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  platform  String   // instagram, tiktok, youtube, etc

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  visits    Visit[]

  createdAt DateTime @default(now())
}

model Visit {
  id          Int      @id @default(autoincrement())

  referralId  Int
  referral    ReferralLink @relation(fields: [referralId], references: [id], onDelete: Cascade)

  campaignId  Int
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  ip          String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([referralId])
  @@index([campaignId])
}

model Campaign {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?

  goal        Int
  currentAmount Float   @default(0)

  status      CampaignStatus @default(ACTIVE)

  createdById Int
  createdBy   User     @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  tickets     Ticket[]
  visits      Visit[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ticket {
  id           Int      @id @default(autoincrement())

  campaignId   Int
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdById  Int
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@index([campaignId])
  @@index([createdById])
}

model Role {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  profiles Profile[]
}

model Profile {
  id              Int      @id @default(autoincrement())
  name            String
  register_number String?
  phone_number    String?
  birthdate       DateTime?

  userId          Int      @unique
  roleId          Int

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role     @relation(fields: [roleId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdRevenue {
  id        Int      @id @default(autoincrement())
  month     Int
  year      Int
  amount    Float

  createdAt DateTime @default(now())

  @@unique([month, year])
}