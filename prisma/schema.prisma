generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  CUSTOMER
}

enum CampaignStatus {
  ACTIVE
  READY_TO_DRAW
  FINISHED
}

enum WithdrawalStatus {
  PENDING
  PAID
  CANCELLED
}

enum MonetizationStatus {
  ESTIMATED
  CONFIRMED
  ADJUSTED
  PAID
}

enum CronSyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

// --- AUTENTICAÇÃO ---
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  emailVerified DateTime?
  profile   Profile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- DADOS DO USUÁRIO ---
model Profile {
  id              Int       @id @default(autoincrement())
  name            String
  register_number String?   // CPF/CNPJ
  phone_number    String?
  birthdate       DateTime?

  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Um Divulgador (USER) tem links, uma carteira e histórico de indicações
  links           ReferralLink[]
  wallet          Wallet?

  // Campanhas que este perfil criou (caso ADMIN)
  campaigns       Campaign[] @relation("CampaignCreatedBy")
  
  // Tickets que este perfil coletou (caso CUSTOMER)
  tickets         Ticket[]
  dailyEarnings   PromoterDailyEarning[]
  drawWinners     CampaignWinner[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// --- FLUXO DE DIVULGAÇÃO ---
model ReferralLink {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  platform  String   // instagram, tiktok, etc

  profileId Int
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  visits    Visit[]
  tickets   Ticket[] // Tickets gerados através deste link específico

  createdAt DateTime @default(now())
}

model Visit {
  id            Int          @id @default(autoincrement())
  
  referralId    Int
  referral      ReferralLink @relation(fields: [referralId], references: [id], onDelete: Cascade)

  campaignId    Int
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  ip            String?
  userAgent     String?
  page          String       @default("campaign")
  
  createdAt     DateTime     @default(now())

  @@index([referralId])
  @@index([campaignId])
  @@index([referralId, campaignId, page, ip, createdAt])
}

// --- CAMPANHAS E TICKETS ---
model Campaign {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  description   String?
  secondDescription String?
  imageUrl      String?
  
  goal          Int
  currentAmount Float          @default(0)

  // Lógica de Tickets
  ticketGoal     Int            @default(0) // Quantos tickets faltam para o sorteio
  ticketValue    Decimal        @default(0) @db.Decimal(10, 4) // Valor estimado por ticket
  currentTickets Int            @default(0) // Quantidade de tickets já coletados

  status        CampaignStatus @default(ACTIVE)

  createdById   Int
  createdBy     Profile        @relation("CampaignCreatedBy", fields: [createdById], references: [id])

  tickets       Ticket[]
  visits        Visit[]
  dailyEarnings PromoterDailyEarning[]
  draws         CampaignDraw[]
  drawWinners   CampaignWinner[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Ticket {
  id            Int          @id @default(autoincrement())
  
  campaignId    Int
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  profileId     Int
  profile       Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Rastreabilidade: Qual link trouxe este ticket?
  referralLinkId Int?
  referralLink   ReferralLink? @relation(fields: [referralLinkId], references: [id])
  drawWinners    CampaignWinner[]

  createdAt     DateTime     @default(now())

  @@index([campaignId])
  @@index([profileId])
}

model CampaignDraw {
  id              Int      @id @default(autoincrement())
  campaignId      Int
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requestedWinners Int
  totalParticipants Int
  seed            String
  createdByUserId Int?
  createdAt       DateTime @default(now())

  winners         CampaignWinner[]

  @@index([campaignId, createdAt])
}

model CampaignWinner {
  id          Int          @id @default(autoincrement())
  drawId      Int
  draw        CampaignDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  campaignId  Int
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  profileId   Int
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  ticketId    Int
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  position    Int
  createdAt   DateTime     @default(now())

  @@unique([drawId, profileId])
  @@unique([drawId, ticketId])
  @@index([campaignId])
  @@index([profileId])
}

// --- FINANCEIRO (DASHBOARD DO DIVULGADOR) ---
model Wallet {
  id          Int      @id @default(autoincrement())
  balance     Float    @default(0) // Saldo disponível para saque
  pending     Float    @default(0) // Saldo do mês atual (ainda não liberado)
  totalEarned Float    @default(0) // Histórico total

  profileId   Int      @unique
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  
  withdrawals Withdrawal[]
}

model Withdrawal {
  id          Int              @id @default(autoincrement())
  amount      Float
  status      WithdrawalStatus @default(PENDING)
  referenceMonth Int?
  referenceYear  Int?
  invoiceUrl     String?
  receiptUrl     String?
  
  walletId    Int
  wallet      Wallet           @relation(fields: [walletId], references: [id])

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  paidAt      DateTime?

  @@unique([walletId, referenceMonth, referenceYear])
  @@index([status])
  @@index([referenceYear, referenceMonth])
}

model AdRevenue {
  id        Int      @id @default(autoincrement())
  month     Int
  year      Int
  amount    Float    // Faturamento total do Google AdSense no mês

  createdAt DateTime @default(now())

  @@unique([month, year])
}

model AdSenseDailyReport {
  id                Int      @id @default(autoincrement())
  date              DateTime @unique @db.Date
  estimatedEarnings Decimal  @default(0) @db.Decimal(12, 4)
  estimatedEarningsUsd Decimal @default(0) @db.Decimal(12, 4)
  exchangeRate      Decimal  @default(1) @db.Decimal(12, 6)
  exchangeRateDate  DateTime? @db.Date
  exchangeRateSource String  @default("manual")
  pageViews         Int      @default(0)
  clicks            Int      @default(0)
  impressions       Int      @default(0)
  pageViewsRpm      Decimal  @default(0) @db.Decimal(12, 4)
  currency          String   @default("BRL")
  sourceCurrency    String   @default("USD")
  source            String   @default("manual")
  rawPayload        Json?
  fetchedAt         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  promoterEarnings  PromoterDailyEarning[]
}

model CronSyncLog {
  id            Int            @id @default(autoincrement())
  job           String
  status        CronSyncStatus @default(RUNNING)
  trigger       String         @default("cron")
  startedAt     DateTime       @default(now())
  finishedAt    DateTime?
  daysRequested Int            @default(0)
  syncedDays    Int            @default(0)
  message       String?
  error         String?
  details       Json?

  @@index([job, startedAt])
  @@index([status])
}

model PromoterDailyEarning {
  id              Int                @id @default(autoincrement())
  date            DateTime           @db.Date
  profileId       Int
  profile         Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  campaignId      Int
  campaign        Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reportId        Int
  report          AdSenseDailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  validVisits     Int                @default(0)
  tickets         Int                @default(0)
  grossRevenue    Decimal            @default(0) @db.Decimal(12, 4)
  promoterShare   Decimal            @default(0) @db.Decimal(12, 4)
  platformShare   Decimal            @default(0) @db.Decimal(12, 4)
  status          MonetizationStatus @default(ESTIMATED)

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([date, profileId, campaignId])
  @@index([profileId, date])
  @@index([campaignId, date])
  @@index([status])
}

model VerificationToken {
  id          Int       @id @default(autoincrement())
  identifier  String    // E-mail do usuário
  token       String?   @unique // Para links (UUID longo)
  code        String?   // Para recuperação de senha (6 dígitos)
  type        TokenType
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([identifier, token, code])
}

enum TokenType {
  EMAIL_VERIFICATION // Via Link
  PASSWORD_RESET     // Via Código OTP
}
