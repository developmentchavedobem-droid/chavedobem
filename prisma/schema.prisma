generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  ADMIN
  USER
  CUSTOMER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  type      UserType

  links     ReferralLink[]
  tickets   Ticket[]
  campaigns Campaign[]     @relation("CampaignCreatedBy")

  profile   Profile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReferralLink {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  platform  String

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  visits    Visit[]

  createdAt DateTime @default(now())
}

model Visit {
  id         Int           @id @default(autoincrement())

  referralId Int
  referral   ReferralLink  @relation(fields: [referralId], references: [id], onDelete: Cascade)

  ip         String?
  userAgent  String?

  createdAt  DateTime      @default(now())
}

model Campaign {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  goal        Int

  createdById Int
  createdBy   User     @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  tickets     Ticket[]

  createdAt   DateTime @default(now())
}

model Ticket {
  id           Int      @id @default(autoincrement())

  campaignId   Int
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdById  Int
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@unique([campaignId, createdById]) // impede múltiplos tickets por usuário na mesma campanha
}

model Role {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  profiles Profile[]
}

model Profile {
  id              Int      @id @default(autoincrement())
  name            String
  register_number String?
  phone_number    String?
  birthdate       DateTime?

  userId          Int      @unique
  roleId          Int

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role     @relation(fields: [roleId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdRevenue {
  id        Int      @id @default(autoincrement())
  month     Int
  year      Int
  amount    Float

  createdAt DateTime @default(now())

  @@unique([month, year])
}
